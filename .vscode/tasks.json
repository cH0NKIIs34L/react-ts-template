// NOTE: tasks.json is JSONC (comments allowed). This configuration is client-only.
{
  "version": "2.0.0",
  "tasks": [
    // ── Development ────────────────────────────────────────────
    {
      "label": "💻 Dev",
      "type": "npm",
      "script": "dev",
      "path": ".",
      "presentation": {
        "group": "dev-env",
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },

    // ── Testing ────────────────────────────────────────────────
    {
      "label": "🧪 Tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "path": ".",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Tests (run once)",
      "type": "npm",
      "script": "test:run",
      "path": ".",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },

    // ── Linting ────────────────────────────────────────────────
    {
      "label": "🔍 Lint (check)",
      "type": "npm",
      "script": "lint",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "🔧 Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": ["$eslint-stylish"]
    },

    // ── Formatting ──────────────────────────────────────────────
    {
      "label": "🎨 Format: Check",
      "type": "npm",
      "script": "format:check",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Format: Fix (write)",
      "type": "npm",
      "script": "format",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },

    // ── CI Verify (mirrors local client tasks) ────────────────
    {
      "label": "✅ CI: Verify All",
      "dependsOn": [
        "🧪 Client: Tests (run once)",
        "🔍 Client: Lint (check)",
        "🎨 Format: Check",
        "🏗️ Client: Build"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      }
    },

    // ── Build ───────────────────────────────────────────────────
    {
      "label": "🏗️ Build",
      "type": "npm",
      "script": "build",
      "path": ".",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },

    // ── Setup ───────────────────────────────────────────────────
    {
      "label": "🛠️ Setup: Install All",
      "type": "npm",
      "script": "install:all",
      "path": ".",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
